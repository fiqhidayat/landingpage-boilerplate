---
// Features section component
const features = [
  {
    title: 'Fast',
    description: 'Optimized for speed and performance'
  },
  {
    title: 'Responsive',
    description: 'Works perfectly on all devices'
  },
  {
    title: 'Modern',
    description: 'Built with latest web technologies'
  }
];
---

<section class="py-20 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold text-center mb-16 text-gray-900">
      Key Features
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="p-6 bg-blue-50 rounded-lg border border-blue-200">
          <h3 class="text-xl font-bold mb-3 text-gray-900">{feature.title}</h3>
          <p class="text-gray-700">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
